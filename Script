local function formatMoney(n)
    n = tonumber(n) or 0
    if n >= 1e12 then return string.format("%.2fT", n/1e12) end
    if n >= 1e9  then return string.format("%.2fB", n/1e9)  end
    if n >= 1e6  then return string.format("%.1fM", n/1e6)  end
    if n >= 1e3  then return string.format("%.0fK", n/1e3)  end
    return tostring(math.floor(n+0.5))
end

local function norm(s) return tostring(s or ""):lower():gsub("[%s_%-%[%]%(%)%.:'/\\]","") end
local function assetsDir() if type(AssetsData) ~= "table" then return nil end return AssetsData.Directory or AssetsData end

local function assetInfo(cat)
    cat = tostring(cat or "")
    local dir = assetsDir()
    if not dir or cat == "" then return nil end
    if dir[cat] then return dir[cat] end
    local key = norm(cat)
    for k,v in pairs(dir) do
        if norm(k) == key then return v end
        if type(v) == "table" and (norm(v.DisplayName)==key or norm(v.Name)==key or norm(v._id)==key) then
            return v
        end
    end
    return nil
end

local function imageId(v)
    if v == nil then return "" end
    if type(v) == "number" then return "rbxassetid://"..tostring(v) end
    local t = tostring(v)
    if t == "" then return "" end
    if t:match("^%d+$") then return "rbxassetid://"..t end
    return t
end

local function assetIcon(cat, rec)
    local icon = rec and (rec.Icon or rec.Image or rec.Thumbnail or rec.Texture or rec.Decal)
    local info = assetInfo(cat)
    if type(info) == "table" then
        icon = icon or info.Icon or info.Image or info.Thumbnail or info.Texture or info.Decal
        if type(info.Pet) == "table" then icon = icon or info.Pet.Icon or info.Pet.Image end
        if type(info.Animal) == "table" then icon = icon or info.Animal.Icon or info.Animal.Image end
        if type(info.Egg) == "table" then icon = icon or info.Egg.Icon or info.Egg.Image end
    end
    return imageId(icon)
end

local function recCat(rec)
    if not rec then return "Egg" end
    local d = rec.AssetCategory or rec.Category or rec.Name or rec.DisplayName or rec.EggName
    if d and tostring(d) ~= "" then return tostring(d) end
    return "Egg"
end

local function mutationMult(rec)
    local m = 1
    local muts = rec and (rec.Mutations or rec.Mutation)
    if type(muts) == "table" then
        for _, x in pairs(muts) do
            if type(x) == "table" then
                m = m * (tonumber(x.Multiplier or x.Value or x.Scale) or 1.5)
            else
                local t = tostring(x):lower()
                if t:find("rainbow") then m = m * 3
                elseif t:find("gold")   then m = m * 2
                else m = m * 1.25 end
            end
        end
    elseif muts then m = 1.5 end
    if rec and rec.HasParasite then m = m * 5 end
    return m
end

local function eggMoney(rec)
    local cat = recCat(rec)
    local info = assetInfo(cat)
    local raw = tonumber(rec and (rec.Money or rec.Cash or rec.Income or rec.EarningRate or rec.Value or rec.Price))
    if (not raw or raw <= 0) and type(info) == "table" then
        raw = tonumber(info.Money or info.Cash or info.Income or info.EarningRate or info.ProfileIncome or info.SalePrice or info.Price)
        if (not raw or raw <= 0) and type(info.Egg) == "table" then
            raw = tonumber(info.Egg.Money or info.Egg.Cash or info.Egg.Income or info.Egg.EarningRate or info.Egg.SalePrice)
        end
    end
    raw = tonumber(raw) or 0
    local scale = tonumber(rec and (rec.AssetScale or rec.Scale or rec.NestScale)) or 1
    return raw * scale * mutationMult(rec)
end

