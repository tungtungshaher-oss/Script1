local function tryGrabOnce(egg,useFly)
    local pos=egg.Pos local uid=egg.Uid
    if useFly then flyTo(pos+Vector3.new(0,3,0),tick()+14)
    else walkTo(pos+Vector3.new(0,2,0),25) end
    if not StealEnabled then return false end
    local r=root()
    if r then pcall(function() r.AssemblyLinearVelocity=Vector3.zero r.AssemblyAngularVelocity=Vector3.zero end) end
    task.wait(0.1)
    local pr=waitPrompt(pos,1.2)
    if pr then
        pcall(function() pr.HoldDuration=0 end)
        if typeof(fireproximityprompt)=="function" then pcall(fireproximityprompt,pr) end
    end
    local t0=tick()
    while not Carrying and tick()-t0<1.2 do Run.Heartbeat:Wait() end
    if Carrying then return true end
    if EggState and type(EggState.CarryFieldEgg)=="function" then pcall(EggState.CarryFieldEgg,uid) end
    local t1=tick()
    while not Carrying and tick()-t1<1.5 do Run.Heartbeat:Wait() end
    return Carrying
end

local function grabEgg(egg)
    local useFly=not AH
    for attempt=1,3 do
        if not StealEnabled then return false end
        if Carrying then return true end
