local function scanEggs()
    if not EggState or type(EggState.ReadFieldEggs)~="function" then return{} end
    local ok,res=pcall(EggState.ReadFieldEggs)
    if not ok or type(res)~="table" or type(res.Records)~="table" then return{} end
    local out={} local r=root()
    for uid,rec in pairs(res.Records) do
        if type(rec)=="table" and rec.State~="Claimed"
        and (rec.State=="Slot" or rec.State=="Dropped")
        and typeof(rec.BottomCFrame)=="CFrame"
        and getRarity(rec.AssetCategory)>=MinRarity then
            local dist=r and (rec.BottomCFrame.Position-r.Position).Magnitude or math.huge
            local money=eggMoney(rec)
            table.insert(out,{Uid=uid,Pos=rec.BottomCFrame.Position,Dist=dist,Rar=getRarity(rec.AssetCategory),Money=money})
        end
    end
    table.sort(out,function(a,b)
        if a.Rar~=b.Rar then return a.Rar>b.Rar end
        return a.Dist<b.Dist
    end)
    if OnlyBestEgg and #out>0 then
        local maxRar=out[1].Rar
        local best={}
        for _,e in ipairs(out) do
            if e.Rar==maxRar then table.insert(best,e) end
        end
        return best
    end
    return out
end

local function findPromptNear(pos,radius)
    radius=radius or 14
    local best,bestDist=nil,math.huge
    for _,obj in ipairs(W:GetChildren()) do
        if obj.Name=="SmartPromptPart" and obj:IsA("BasePart") then
            local pp=obj:FindFirstChild("CarryAreaEgg")
            if pp and pp:IsA("ProximityPrompt") and pp.Enabled then
                local d=(obj.Position-pos).Magnitude
                if d<radius and d<bestDist then best,bestDist=pp,d end
            end
        end
    end
    local slots=W:FindFirstChild("AreaEggSlotsClient")
    if slots then
        for _,obj in ipairs(slots:GetChildren()) do
            if obj:IsA("Model") then
                local pp=obj:FindFirstChild("CarryAreaEgg")
                if pp and pp:IsA("ProximityPrompt") and pp.Enabled then
                    local ok2,pivot=pcall(function() return obj:GetPivot().Position end)
                    if ok2 then
                        local d=(pivot-pos).Magnitude
                        if d<radius and d<bestDist then best,bestDist=pp,d end
                    end
                end
            end
        end
    end
    return best
end

