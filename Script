local function flyTo(target,deadline)
    deadline=deadline or tick()+25
    local r=root() if not r then return false end
    while tick()<deadline and StealEnabled do
        r=root() if not r then return false end
        local diff=target-r.Position
        if diff.Magnitude<3 then
            pcall(function() r.AssemblyLinearVelocity=Vector3.zero end)
            return true
        end
        local spd=getSpeed()
        local vel=diff.Unit*math.min(spd,diff.Magnitude/0.05)
        pcall(function()
            r.AssemblyLinearVelocity=Vector3.new(vel.X,vel.Y+W.Gravity*0.016,vel.Z)
            r.AssemblyAngularVelocity=Vector3.zero
        end)
        Run.Heartbeat:Wait()
    end
    return false
end

local function walkTo(target,timeout)
    timeout=timeout or 20
    local h=hum() local r=root() if not h or not r then return false end
    h:MoveTo(target)
    local t0=tick()
    while tick()-t0<timeout and StealEnabled do
        r=root() h=hum() if not r or not h then return false end
        if (r.Position-target).Magnitude<4 then
            h:Move(Vector3.zero,false)
            return true
        end
        if (tick()-t0)%0.5<0.02 then h:MoveTo(target) end
        Run.Heartbeat:Wait()
    end
    return false
end

